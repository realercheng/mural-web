# Copy to a private .env outside the repository. Never commit real values.
# Comma-separated when a regional front proxy also serves the app.
PUBLIC_ORIGIN=https://mural.example.com
LIVE_UPSTREAM_URL=wss://llm-gateway.example.com/v1/live/sessions
LIVE_UPSTREAM_KEY=replace-with-a-gateway-key-limited-to-gpt-live-1
LIVE_MODEL=gpt-live-1
ACCESS_CODE=replace-with-at-least-16-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=true
MAX_SESSION_SECONDS=600
DAILY_LIMIT_SECONDS=1200
# Calendar month in USAGE_TIME_ZONE.
MONTHLY_LIMIT_SECONDS=36000
TOTAL_LIMIT_SECONDS=2400
IDLE_AUDIO_SECONDS=10
USAGE_TIME_ZONE=Asia/Shanghai
# Optional: kid-mode parent reports and stars, subtitles, word lookup and typed replies.
# Leave TEXT_UPSTREAM_URL empty to turn them off.
TEXT_UPSTREAM_URL=https://llm-gateway.example.com/v1
TEXT_UPSTREAM_KEY=replace-with-a-gateway-key-limited-to-the-text-model
TEXT_MODEL=gpt-6-luna
# Shared budget for subtitles, word lookup and typed replies (parent reports are not counted).
HELPER_PER_MINUTE=12
HELPER_DAILY_LIMIT=600
