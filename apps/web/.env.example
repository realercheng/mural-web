# Copy to a private .env outside the repository. Never commit real values.
PUBLIC_ORIGIN=https://mural.example.com
LIVE_UPSTREAM_URL=wss://llm-gateway.example.com/v1/live/sessions
LIVE_UPSTREAM_KEY=replace-with-a-gateway-key-limited-to-gpt-live-1
LIVE_MODEL=gpt-live-1
ACCESS_CODE=replace-with-at-least-16-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=true
MAX_SESSION_SECONDS=600
DAILY_LIMIT_SECONDS=1200
TOTAL_LIMIT_SECONDS=2400
IDLE_AUDIO_SECONDS=10
USAGE_TIME_ZONE=Asia/Shanghai
